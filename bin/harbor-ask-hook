#!/usr/bin/env node
'use strict';

// harbor-ask-hook: PreToolUse AskUserQuestion, PermissionRequest and Elicitation.
//
// Ask answers update tool input; the new lanes return their event decisions.
// Unsupported prompt shapes, absent/stale heartbeat, absent lane capability,
// ownership pass, no claim within CLAIM_WAIT_MS, or Harbor gone mid-wait all
// mean no output and exit 0. The CLI then owns its native dialog.
// Legacy asks use *.request.json. Kind-prefixed UUIDs and *.kind.pending.json
// keep the new lanes invisible to old inboxes; fresh advertised lanes are
// required before writing them. Only the no-claim path waits three seconds.
//
// Installed by app/scripts/install-ask-hook.js into the master settings
// (all three config homes via sync-plans) with a 12 hour timeout; the CLI
// treats a timed-out hook as no decision, which is the same step-aside.
//
// Protocol and file shapes: app/src/shared/ask-protocol.cjs. The proof this
// works against the real CLI: app/scripts/probe-ask-hook-win.js.

const fs = require('node:fs');
const path = require('node:path');

const proto = require(path.join(path.dirname(__dirname), 'app', 'src', 'shared', 'ask-protocol.cjs'));

const dir = proto.defaultAskDir(process.env);
const now = () => Date.now();
const sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms));

function log(line) {
  try {
    fs.mkdirSync(dir, { recursive: true });
    fs.appendFileSync(path.join(dir, 'hook.log'), `${new Date().toISOString()} pid=${process.pid} ${line}\n`);
  } catch { /* logging never blocks a question */ }
}

function stepAside(why, files) {
  log(`step aside: ${why}`);
  if (files) for (const file of [files.request, files.claim, files.answer, files.pass]) { try { fs.unlinkSync(file); } catch { /* absent */ } }
  process.exit(0);
}

async function main() {
  let raw = '';
  process.stdin.setEncoding('utf8');
  for await (const chunk of process.stdin) raw += chunk;
  let input;
  try { input = JSON.parse(raw); } catch { return stepAside('unreadable stdin'); }
  const prompt = proto.promptForInput(input);
  if (!prompt) return stepAside(`unsupported prompt (${input.hook_event_name || input.tool_name})`);
  const { kind } = prompt;
  const heartbeatFresh = () => proto.heartbeatFresh(dir, now(), proto.HEARTBEAT_STALE_MS, kind);
  if (!heartbeatFresh()) return stepAside('no fresh Harbor heartbeat for this lane');

  const id = proto.requestId(input, kind);
  const files = proto.filesFor(dir, id, kind);
  const request = {
    v: 1,
    kind,
    prompt: prompt.prompt,
    id,
    at: now(),
    hookPid: process.pid,
    sessionId: input.session_id || null,
    transcriptPath: input.transcript_path || null,
    cwd: input.cwd || null,
    toolUseId: input.tool_use_id || null,
    toolInput: input.tool_input || {},
  };
  try { proto.writeJsonAtomic(files.request, request); } catch (error) { return stepAside(`could not write request: ${error.message}`); }
  log(`request ${id} session=${request.sessionId} kind=${kind} questions=${input.tool_input?.questions?.length || 0}`);

  // Harbor claims a session it is showing within CLAIM_WAIT_MS; silence means
  // this session is not Harbor's to answer.
  const claimDeadline = now() + proto.CLAIM_WAIT_MS;
  let claimed = false;
  while (now() < claimDeadline) {
    if (!heartbeatFresh()) return stepAside('Harbor went away before claim', files);
    if (fs.existsSync(files.claim)) { claimed = true; break; }
    if (fs.existsSync(files.pass)) return stepAside('Harbor passed (not a session it shows)', files);
    await sleep(100);
  }
  if (!claimed) return stepAside(`no claim within ${proto.CLAIM_WAIT_MS}ms`, files);
  log(`claimed ${id}`);

  // Wait for the answer as long as Harbor stays alive.
  for (;;) {
    const answer = proto.readJson(files.answer);
    if (answer) {
      if (!heartbeatFresh()) return stepAside('Harbor went away before answer', files);
      const output = proto.hookOutputFor(input.tool_input, answer, kind);
      process.stdout.write(JSON.stringify(output));
      log(`answered ${id}: ${answer.decline ? 'declined' : `${Object.keys(answer.answers || {}).length} answer(s)`}`);
      for (const file of [files.request, files.claim, files.answer, files.pass]) { try { fs.unlinkSync(file); } catch { /* absent */ } }
      return process.exit(0);
    }
    if (!heartbeatFresh()) return stepAside('Harbor went away while waiting', files);
    await sleep(proto.ANSWER_POLL_MS);
  }
}

main().catch((error) => stepAside(`error: ${error && error.message}`));
